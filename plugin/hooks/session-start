#!/usr/bin/env bash
# SessionStart hook：把 plain-language 的写作规则注入上下文；顺带把 statusline/ 下的
# 状态栏脚本和 rules/ 下的常驻规则同步到配置目录，再给上游 i-have-adhd 插件建上它的
# 常驻标记文件。
# 任何异常都静默退出——绝不阻塞会话。
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
RULES_FILE="${PLUGIN_ROOT}/skills/plain-language/rules.md"

# ── 同步到配置目录 ────────────────────────────────────────────────
# 同步两样东西：statusline/ 下的状态栏脚本，和 rules/ 下的常驻规则。
#
# 为什么要复制，而不是让配置直接指向插件目录：插件安装目录带版本号
# （.../cache/shared-skills/shared-skills/<版本号>/），升级后旧目录就没了；而
# statusLine 命令里又拿不到 CLAUDE_PLUGIN_ROOT（官方列举的占位符解析位置不含
# statusLine）。所以插件带脚本还不够，必须把它落到一个与版本无关的固定位置。
# rules/ 同理：目标目录 <配置目录>/rules/ 本身就得是个固定路径。
#
# 为什么放在这个 hook 里、而不是单独挂一个：单独挂要走一次 run-hook.cmd，本机实测
# 光进程启动就约 140ms；折在这里复用已算好的 PLUGIN_ROOT，增量只有比较文件的
# 约 1.5ms。插件系统没有「安装时触发」的 hook 事件，每次会话顺带同步也是唯一
# 能让内容随插件升级自动跟上的做法。
#
# 全程不往 stdout 写一个字：SessionStart 的纯文本输出会被当成上下文喂给模型。

# 配置目录：设了 CLAUDE_CONFIG_DIR 就是它，没设就是 ~/.claude；两个都没有则输出空。
config_dir() {
    if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
        printf '%s' "$CLAUDE_CONFIG_DIR"
    elif [ -n "${HOME:-}" ]; then
        printf '%s' "$HOME/.claude"
    fi
}

# sync_file <源文件> <目标目录> <目标文件名>
sync_file() {
    local src="$1" dst_dir="$2" name="$3" dst
    [ -f "$src" ] || return 0
    dst="${dst_dir}/${name}"
    # 内容一致就不动文件，所以这一步是幂等的。用 bash 内建读入比较，不用 cmp：
    # cmp 是外部程序，本机实测起一次进程约 58ms，读进变量只要约 1.2ms。
    # 代价是 $(<file) 会剥掉末尾换行，两个文件只在末尾换行上不同时看不出来——
    # 后果仅仅是那次不复制，可以接受。
    if [ -f "$dst" ] && [ "$(<"$src")"$'\n' = "$(<"$dst")"$'\n' ]; then
        return 0
    fi
    [ -d "$dst_dir" ] || mkdir -p "$dst_dir" 2>/dev/null || return 0
    cp "$src" "$dst" 2>/dev/null || true
}

CFG_DIR="$(config_dir)"
if [ -n "$CFG_DIR" ]; then
    for f in statusline.py subagent-statusline.py; do
        sync_file "${PLUGIN_ROOT}/statusline/${f}" "$CFG_DIR" "$f"
    done

    # rules/ 下每个 .md 同步到 <配置目录>/rules/。那是 Claude Code 的用户级常驻
    # 规则位置，里面的 *.md 会和 CLAUDE.md 一起自动加载。
    # 不往 <配置目录>/CLAUDE.md 写：那是用户自己的记忆文件，插件往里写会覆盖掉
    # 用户自己定的规则；rules/ 才是插件可以自己占用的目录。
    for f in "${PLUGIN_ROOT}"/rules/*.md; do
        [ -f "$f" ] || continue
        sync_file "$f" "${CFG_DIR}/rules" "${f##*/}"
    done

    # ── ADHD 输出形状：替上游插件建它的常驻标记文件 ────────────────────
    # 上游 i-have-adhd 插件的 SessionStart 钩子只在 <配置目录>/.i-have-adhd-always
    # 存在时才把它的规则注入上下文——光装插件不改变任何行为，得有人建这个文件。
    # 这里替它建上，那套输出形状规则就每次会话自动生效。
    #
    # 为什么不把那份正文抄进本仓库：那套内容的价值全在措辞上（上游自己带评测磨过），
    # 抄一份就得跟着同步，还多一份「两处维护必然漂移」的账。建个空文件让它自己注入，
    # 内容永远跟上游最新。
    # 代价写在 README 的「ADHD 输出形状」一节：这条链子依赖上游插件装着，没装就
    # 静默失效（规则一个字都不进上下文，不报错）；删掉这个文件也关不掉，下一会话
    # 又会建回来——要关得改这一段。
    #
    # 已存在就不动：上游只判文件在不在，内容没有意义，覆盖只会抹掉用户自己塞的东西。
    ADHD_FLAG="${CFG_DIR}/.i-have-adhd-always"
    if [ ! -e "$ADHD_FLAG" ]; then
        [ -d "$CFG_DIR" ] || mkdir -p "$CFG_DIR" 2>/dev/null || true
        : > "$ADHD_FLAG" 2>/dev/null || true
    fi
fi

[ -f "$RULES_FILE" ] || exit 0
rules_content="$(cat "$RULES_FILE" 2>/dev/null)" || exit 0
[ -n "$rules_content" ] || exit 0

# 单次参数替换转义，比逐字符循环快几个数量级
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# 限定语要连 rules.md 的开头一起读：那份规则是按「写的时候怎么做」组织的（表里每一行
# 都是落笔时的动作与它的反面），不是一份事后检查清单，所以这里点明时序。措辞改动没有
# 任何断言拦着——checks/verify.d/10 只验这段的结构（开标签、非空正文、闭标签）与「后面接的就是
# rules.md 原文」，故意不比对措辞，免得脚本里再存一份副本、两处维护必然漂移。
rules_escaped="$(escape_for_json "$rules_content")"
context="<EXTREMELY_IMPORTANT>\n你写给人看的文字，一律按下面这份要求来，落笔时就按它写，不是写完再拿它检查：回答、文档、说明、提交信息正文。\n</EXTREMELY_IMPORTANT>\n\n${rules_escaped}"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context"

exit 0
